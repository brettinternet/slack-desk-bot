SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_AGENT_CWD=/absolute/path/to/repository
SLACK_ALLOWED_USER_IDS=U01234567,U07654321
# pi (default), codex, or claude. Claude supports read-only and read-write modes.
SLACK_AGENT_BACKEND=pi
# Optional Codex paths. Use a dedicated CODEX_HOME and authenticate it with Keychain storage.
# SLACK_CODEX_EXECUTABLE=/absolute/path/to/codex
# SLACK_CODEX_HOME=/absolute/path/to/slack-desk-codex-home
# Optional Claude Code paths. Use a dedicated config directory and authenticate it with `claude auth login`.
# SLACK_CLAUDE_EXECUTABLE=/absolute/path/to/claude
# SLACK_CLAUDE_HOME=/absolute/path/to/slack-desk-claude-home
# Optional subset of allowed users who may cancel another user's active request.
# SLACK_OPERATOR_USER_IDS=U01234567
SLACK_AGENT_MODE=read-only
SLACK_AGENT_HEALTH_PORT=3210
# SLACK_AGENT_SOCKET_PATH=/absolute/path/to/control.sock

# Set at most one optional Slack-specific instruction source.
# SLACK_AGENT_INSTRUCTIONS=Be concise and conversational.
# SLACK_AGENT_INSTRUCTIONS_FILE=/absolute/path/to/instructions.md

# Optional session storage and resource limits (defaults shown)
# SLACK_AGENT_SESSION_DIR=/absolute/path/to/session-storage
SLACK_AGENT_MAX_ACTIVE_SESSIONS=32
SLACK_AGENT_SESSION_IDLE_MS=3600000
SLACK_AGENT_TIMEOUT_MS=300000
SLACK_AGENT_QUEUE_WAIT_MS=600000
SLACK_AGENT_MAX_QUEUE_PER_CONVERSATION=2
# Read-write mode always uses 1 to prevent concurrent writers in the shared checkout.
SLACK_AGENT_MAX_CONCURRENT_CONVERSATIONS=3
SLACK_AGENT_MAX_GLOBAL_QUEUE=20
SLACK_AGENT_MAX_PENDING_PER_USER=3
SLACK_AGENT_RATE_LIMIT_BURST=3
SLACK_AGENT_RATE_LIMIT_REFILL_MS=60000
